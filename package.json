{
  "name": "tic-rush",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "serve:ionic": "ionic serve",
    "cap:sync": "npx cap sync android",
    "cap:copy": "npx cap copy android",
    "cap:open:android": "npx cap open android",
    "ionic:serve:direct": "ng serve --host localhost --port 8100",
    "serve:8100": "ng serve --host localhost --port 8100",
    "cap:add:android": "npx cap add android",
    "cap:prepare": "npm run build && npx cap sync android",
    "cap:android": "npm run build && npx cap add android"
  },
  "dependencies": {
    "@angular/animations": "20.3.0",
    "@angular/common": "20.3.0",
    "@angular/compiler": "20.3.0",
    "@angular/core": "20.3.0",
    "@angular/forms": "20.3.0",
    "@angular/platform-browser": "20.3.0",
    "@angular/platform-browser-dynamic": "20.3.0",
    "@angular/router": "20.3.0",
    "@capacitor-community/admob": "^7.0.3",
    "@capacitor/android": "7.4.0",
    "@capacitor/core": "7.4.0",
    "@ionic/angular": "8.7.0",
    "ionicons": "7.4.0",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "zone.js": "0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "20.3.0",
    "@angular/cli": "20.3.0",
    "@angular/compiler-cli": "20.3.0",
    "@capacitor/cli": "7.4.0",
    "sass": "1.90.0",
    "typescript": "5.8.3"
  },
  "description": "Fast Ionic Angular Tic Tac Toe arcade game"
}
